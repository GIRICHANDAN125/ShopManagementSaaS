# ==============================================================================
# Multi-Tenant Shop SaaS - Backend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env before starting the backend:
#   cp .env.example .env
# Never commit the populated .env to source control.

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Connections (Three-Role Security Architecture)
# ------------------------------------------------------------------------------
# The system strictly separates database access across three distinct roles:
#
# A. shopapp_migrator:
#    - Schema owner, used ONLY for migrations (`npm run migrate:up`).
#    - Never used by the application runtime.
DATABASE_URL="postgresql://shopapp_migrator:MIGRATOR_PASSWORD_PLACEHOLDER@localhost:5432/shopapp_dev?schema=public"

# B. shopapp (Runtime Role):
#    - Used for all ordinary shop operations (orders, catalog, employees, reports).
#    - NOSUPERUSER, NOBYPASSRLS.
#    - Bound by PostgreSQL Row-Level Security (RLS) on every tenant-owned table.
RUNTIME_DATABASE_URL="postgresql://shopapp:RUNTIME_PASSWORD_PLACEHOLDER@localhost:5432/shopapp_dev?schema=public"

# C. shopapp_superadmin (Platform Role):
#    - Used strictly by the SuperAdmin module and initial Super Admin bootstrap.
#    - NOSUPERUSER, NOBYPASSRLS.
#    - Narrowly granted to `tenants` and platform-level (`tenant_id IS NULL`) rows only.
#    - Has zero grants on shop-operational tables (orders, products, etc.).
SUPERADMIN_DATABASE_URL="postgresql://shopapp_superadmin:SUPERADMIN_PASSWORD_PLACEHOLDER@localhost:5432/shopapp_dev?schema=public"

# ------------------------------------------------------------------------------
# 2. First Super Admin Bootstrap Credentials
# ------------------------------------------------------------------------------
# Used by `npm run bootstrap:superadmin` to seed the first platform Super Admin.
# Passwords are automatically hashed with Argon2id.
SUPERADMIN_USERNAME="superadmin"
SUPERADMIN_PASSWORD="CHANGE_ME_SUPERADMIN_SECURE_PASSWORD"
SUPERADMIN_DISPLAY_NAME="Platform Super Admin"

# ------------------------------------------------------------------------------
# 3. Authentication Secrets & Token Expirations
# ------------------------------------------------------------------------------
# Generate long, cryptographically random strings (e.g., node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET="CHANGE_ME_GENERATE_LONG_RANDOM_ACCESS_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_GENERATE_LONG_RANDOM_REFRESH_SECRET"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ------------------------------------------------------------------------------
# 4. Device Credentials (Hardware / TV / Counter)
# ------------------------------------------------------------------------------
# HMAC pepper used when hashing device credentials (SECURITY.md §19).
DEVICE_CREDENTIAL_PEPPER="CHANGE_ME_GENERATE_LONG_RANDOM_DEVICE_PEPPER"

# ------------------------------------------------------------------------------
# 5. Server & Networking
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# ------------------------------------------------------------------------------
# 6. Integration Test Suite Superuser Credential
# ------------------------------------------------------------------------------
# The integration test suite (`npm run test:integration`) needs a privileged
# connection solely to reset test fixtures between runs (production code never
# uses postgres superuser credentials).
TEST_SUPERUSER_DB_PASSWORD="POSTGRES_DOCKER_PASSWORD_PLACEHOLDER"
TEST_RUNTIME_DB_PASSWORD="RUNTIME_PASSWORD_PLACEHOLDER"
